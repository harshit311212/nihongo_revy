const QUIZ_POOL_GROUPS = ['hiragana_base','hiragana_dakuten','hiragana_handakuten','katakana_base','katakana_dakuten','katakana_handakuten'];
function quizPool(){
  return Object.entries(KANA).filter(([,v])=>QUIZ_POOL_GROUPS.includes(v.group));
}
let quizState = null;
function startQuiz(){
  const pool = quizPool();
  const picks = shuffle(pool).slice(0, 10);
  quizState = { questions: picks, index: 0, score: 0, answered:false };
  renderQuizQuestion();
}
function uniqueDistractors(poolArr, correctChar, correctRomaji, n){
  const out = [];
  const seenRomaji = new Set([correctRomaji]);
  const shuffled = shuffle(poolArr);
  for(const [ch,v] of shuffled){
    if(ch===correctChar) continue;
    if(seenRomaji.has(v.romaji)) continue;
    seenRomaji.add(v.romaji);
    out.push([ch,v]);
    if(out.length>=n) break;
  }
  return out;
}
function renderQuizQuestion(){
  if(!quizState) return;
  if(quizState.index >= quizState.questions.length){
    renderQuizEnd(startQuiz);
    return;
  }
  const [char, data] = quizState.questions[quizState.index];
  const pool = quizPool();
  const distractors = uniqueDistractors(pool, char, data.romaji, 3);
  const options = shuffle([[char,data], ...distractors]);
  quizState.answered = false;

  quizArea.innerHTML = '';
  const meta = document.createElement('div');
  meta.className = 'quiz-meta';
  meta.innerHTML = '<span>Question '+(quizState.index+1)+' / '+quizState.questions.length+'</span><span>Score '+quizState.score+'</span>';
  quizArea.appendChild(meta);

  const stage = document.createElement('div');
  stage.className = 'quiz-stage';

  if(quizMode === 'see'){
    stage.innerHTML = '<div class="quiz-prompt">'+char+'</div><div class="quiz-sub">Which sound is this?</div>';
  }else{
    stage.innerHTML = '<div class="quiz-sub">Listen, then tap the matching character</div><button class="btn-main" id="quizPlayBtn">🔊 Play sound</button>';
  }
  const optWrap = document.createElement('div');
  optWrap.className = 'quiz-options';
  optWrap.style.marginTop = '16px';
  options.forEach(([oc,od])=>{
    const b = document.createElement('button');
    b.className = 'quiz-opt';
    b.textContent = quizMode === 'see' ? od.romaji : oc;
    b.addEventListener('click', ()=>{
      if(quizState.answered) return;
      quizState.answered = true;
      const isCorrect = oc === char;
      b.classList.add(isCorrect ? 'correct' : 'wrong');
      if(isCorrect) quizState.score++;
      else{
        optWrap.querySelectorAll('.quiz-opt').forEach(el=>{
          if(el.textContent === (quizMode==='see'?data.romaji:char)) el.classList.add('correct');
        });
      }
      setTimeout(()=>{ quizState.index++; renderQuizQuestion(); }, 850);
    });
    optWrap.appendChild(b);
  });
  stage.appendChild(optWrap);
  quizArea.appendChild(stage);

  if(quizMode === 'hear'){
    const playBtn = document.getElementById('quizPlayBtn');
    const playIt = ()=>speak(char);
    playBtn.addEventListener('click', playIt);
    setTimeout(playIt, 200);
  }
}

/* ---- listening quiz ---- */
const LISTEN_TOPICS = {
  greetings: CONTENT.greetings,
  weekdays: CONTENT.weekdays,
  months: CONTENT.months,
  numbers: CONTENT.numbers,
  age: CONTENT.age,
  timeHours: CONTENT.timeHours,
};
function cleanJp(jp){ return jp.replace(/\s*\/.*/,''); }
function cleanLabel(en){ return en.replace(/\s*\(.*$/,''); }
function listenPool(topic){
  const keys = topic === 'mixed' ? Object.keys(LISTEN_TOPICS) : [topic];
  const out = [];
  keys.forEach(key=>{
    (LISTEN_TOPICS[key] || []).forEach(item=>out.push(Object.assign({topic:key}, item)));
  });
  return out;
}
let listenTopic = 'mixed';
document.querySelectorAll('#listenTopicRow .mode-btn').forEach(btn=>{
  btn.addEventListener('click', ()=>{
    document.querySelectorAll('#listenTopicRow .mode-btn').forEach(b=>b.classList.remove('active'));
    btn.classList.add('active');
    listenTopic = btn.dataset.topic;
    startListeningQuiz();
  });
});
let listenState = null;
function startListeningQuiz(){
  const pool = listenPool(listenTopic);
  const picks = shuffle(pool).slice(0, 10);
  listenState = { questions: picks, index: 0, score: 0, answered:false };
  renderListenQuestion();
}
function listenDistractors(correctItem, n){
  const samePool = listenPool(correctItem.topic);
  const out = [];
  const seen = new Set([cleanLabel(correctItem.en)]);
  shuffle(samePool).forEach(it=>{
    if(out.length>=n) return;
    const label = cleanLabel(it.en);
    if(it.jp===correctItem.jp || seen.has(label)) return;
    seen.add(label);
    out.push(it);
  });
  return out;
}
function renderListenQuestion(){
  if(!listenState) return;
  if(listenState.index >= listenState.questions.length){
    renderQuizEnd(startListeningQuiz);
    return;
  }
  const correct = listenState.questions[listenState.index];
  const distractors = listenDistractors(correct, 3);
  const options = shuffle([correct, ...distractors]);
  listenState.answered = false;

  quizArea.innerHTML = '';
  const meta = document.createElement('div');
  meta.className = 'quiz-meta';
  meta.innerHTML = '<span>Question '+(listenState.index+1)+' / '+listenState.questions.length+'</span><span>Score '+listenState.score+'</span>';
  quizArea.appendChild(meta);

  const stage = document.createElement('div');
  stage.className = 'quiz-stage';
  stage.innerHTML =
    '<button class="quiz-speaker-btn" id="listenPlayBtn" aria-label="Play sound">🔊</button>'+
    '<div class="quiz-replay">Tap to listen, then choose what it means</div>';
  const optWrap = document.createElement('div');
  optWrap.className = 'quiz-options wide';
  optWrap.style.marginTop = '16px';
  options.forEach(opt=>{
    const b = document.createElement('button');
    b.className = 'quiz-opt text-opt';
    b.textContent = cleanLabel(opt.en);
    b.addEventListener('click', ()=>{
      if(listenState.answered) return;
      listenState.answered = true;
      const isCorrect = opt.jp === correct.jp;
      b.classList.add(isCorrect ? 'correct' : 'wrong');
      if(isCorrect) listenState.score++;
      else{
        optWrap.querySelectorAll('.quiz-opt').forEach(el=>{
          if(el.textContent === cleanLabel(correct.en)) el.classList.add('correct');
        });
      }
      setTimeout(()=>{ listenState.index++; renderListenQuestion(); }, 900);
    });
    optWrap.appendChild(b);
  });
  stage.appendChild(optWrap);
  quizArea.appendChild(stage);

  const playIt = ()=>speak(cleanJp(correct.jp));
  document.getElementById('listenPlayBtn').addEventListener('click', playIt);
  setTimeout(playIt, 200);
}

function renderQuizEnd(retryFn){
  quizArea.innerHTML =
    '<div class="quiz-end">'+
      '<div class="quiz-sub">You scored</div>'+
      '<div class="score">'+(quizType==='kana'?quizState.score:listenState.score)+' / '+(quizType==='kana'?quizState.questions.length:listenState.questions.length)+'</div>'+
      '<button class="btn-main" id="quizRetry" style="margin-top:14px;">Try again</button>'+
    '</div>';
  document.getElementById('quizRetry').addEventListener('click', retryFn);
}
startQuiz();

/* ---------------- init ---------------- */
updateProgressRing();

})();
</script>

</body></html>
