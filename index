"},{"jp":"さようなら","romaji":"sayounara","en":"Goodbye"},{"jp":"ありがとうございます","romaji":"arigatou gozaimasu","en":"Thank you"},{"jp":"すみません","romaji":"sumimasen","en":"Excuse me / I'm sorry"},{"jp":"はじめまして","romaji":"hajimemashite","en":"Nice to meet you (first meeting)"},{"jp":"どうぞよろしくお願いします","romaji":"douzo yoroshiku onegaishimasu","en":"Please be kind to me / Pleased to meet you"},{"jp":"お願いします","romaji":"onegaishimasu","en":"Please (requesting something)"},{"jp":"失礼します","romaji":"shitsurei shimasu","en":"Excuse me (entering/leaving)"},{"jp":"いってきます","romaji":"itte kimasu","en":"I'm off (leaving home)"},{"jp":"いってらっしゃい","romaji":"itterasshai","en":"See you off / Take care"},{"jp":"ただいま","romaji":"tadaima","en":"I'm home"},{"jp":"おかえりなさい","romaji":"okaerinasai","en":"Welcome back"}],"selfIntro":{"lines":[{"jp":"はじめまして。","romaji":"Hajimemashite.","en":"Nice to meet you.","fixed":true},{"jp":"わたしは＿＿＿です。","romaji":"Watashi wa ___ desu.","en":"I am ___.","slot":"name"},{"jp":"＿＿＿からきました。","romaji":"___ kara kimashita.","en":"I come from ___.","slot":"country"},{"jp":"＿＿＿です。","romaji":"___ desu.","en":"I am a ___ (job/role).","slot":"job"},{"jp":"どうぞよろしくお願いします。","romaji":"Douzo yoroshiku onegaishimasu.","en":"Pleased to meet you / please be kind to me.","fixed":true}],"names":[{"jp":"田中","romaji":"Tanaka","en":"Tanaka"},{"jp":"ハリシット","romaji":"Harushitto","en":"Harshit"},{"jp":"ゆき","romaji":"Yuki","en":"Yuki"},{"jp":"けん","romaji":"Ken","en":"Ken"}],"countries":[{"jp":"インド","romaji":"Indo","en":"India"},{"jp":"日本","romaji":"Nihon","en":"Japan"},{"jp":"アメリカ","romaji":"Amerika","en":"USA"},{"jp":"中国","romaji":"Chuugoku","en":"China"}],"jobs":[{"jp":"学生","romaji":"gakusei","en":"student"},{"jp":"先生","romaji":"sensei","en":"teacher"},{"jp":"エンジニア","romaji":"enjinia","en":"engineer"},{"jp":"会社員","romaji":"kaishain","en":"office worker"}]},"grammar":[{"id":"wa-desu","title":"N1 は N2 です","subtitle":"N1 wa N2 desu — \"N1 is N2\"","explanation":"The particle は (written 'ha', read 'wa' when used as a particle) marks the topic. です is the polite copula, roughly \"is / am / are\". This is the basic sentence pattern for stating what something or someone is.","examples":[{"jp":"わたしは 学生 です。","romaji":"Watashi wa gakusei desu.","en":"I am a student."},{"jp":"テレーザさんは ブラジル人 です。","romaji":"Teresa-san wa Burajiru-jin desu.","en":"Ms. Teresa is Brazilian."},{"jp":"これは 本 です。","romaji":"Kore wa hon desu.","en":"This is a book."}]},{"id":"ja-arimasen","title":"N1 は N2 じゃありません","subtitle":"N1 wa N2 ja arimasen — \"N1 is not N2\"","explanation":"To make です negative, replace it with じゃありません (casual/spoken) or ではありません (more formal/written). Both mean \"is not\".","examples":[{"jp":"わたしは 先生 じゃありません。","romaji":"Watashi wa sensei ja arimasen.","en":"I am not a teacher."},{"jp":"ミラーさんは 学生 では ありません。","romaji":"Mirā-san wa gakusei dewa arimasen.","en":"Mr. Miller is not a student."},{"jp":"これは わたしの かばん じゃありません。","romaji":"Kore wa watashi no kaban ja arimasen.","en":"This is not my bag."}]},{"id":"ka-question","title":"N1 は N2 ですか","subtitle":"...desu ka — the question particle か","explanation":"Adding か to the end of a です sentence turns a statement into a yes/no question. Japanese keeps the word order the same — no inversion needed — and usually drops the question mark in writing since か already signals a question.","examples":[{"jp":"あなたは 学生 ですか。","romaji":"Anata wa gakusei desu ka.","en":"Are you a student?"},{"jp":"はい、学生 です。","romaji":"Hai, gakusei desu.","en":"Yes, I am a student."},{"jp":"いいえ、学生 じゃありません。","romaji":"Iie, gakusei ja arimasen.","en":"No, I am not a student."}]},{"id":"mo","title":"N1 も N2 です","subtitle":"N1 mo N2 desu — \"N1 is also N2\"","explanation":"も replaces は when the same thing you just said about one topic is also true for another topic — it means \"also / too\".","examples":[{"jp":"わたしは 学生 です。ワンさんも 学生 です。","romaji":"Watashi wa gakusei desu. Wan-san mo gakusei desu.","en":"I am a student. Mr. Wang is also a student."},{"jp":"これは ペンです。それも ペンです。","romaji":"Kore wa pen desu. Sore mo pen desu.","en":"This is a pen. That is also a pen."}]},{"id":"no","title":"N1 の N2","subtitle":"N1 no N2 — linking two nouns","explanation":"の connects two nouns, with the first describing or owning the second — similar to \"'s\" or \"of\" in English. Word order is the reverse of English: the describing word comes first.","examples":[{"jp":"わたしの 本","romaji":"watashi no hon","en":"my book"},{"jp":"日本語の 先生","romaji":"nihongo no sensei","en":"Japanese teacher (teacher of Japanese)"},{"jp":"これは わたしの かばんです。","romaji":"Kore wa watashi no kaban desu.","en":"This is my bag."}]},{"id":"san","title":"〜さん の使い方","subtitle":"Using the honorific suffix さん","explanation":"さん is attached after someone else's name (family name, full name, or first name) as a polite title, similar to Mr./Ms./Mx. — but it is never attached to your own name, and never used alone without a name.","examples":[{"jp":"田中さんは 先生 です。","romaji":"Tanaka-san wa sensei desu.","en":"Mr./Ms. Tanaka is a teacher. (correct — used for someone else)"},{"jp":"✗ わたしは ハリシットさんです。","romaji":"✗ Watashi wa Harshit-san desu.","en":"Incorrect — never add さん to your own name."},{"jp":"ミラーさんは アメリカ人です。","romaji":"Mirā-san wa Amerika-jin desu.","en":"Mr. Miller is American."}]}],"sokuon":{"explanation":"The small っ (hiragana) or ッ (katakana) creates a brief, silent pause before the next consonant — doubling it in romaji. It is never pronounced on its own; it just holds the beat of one mora before the following sound.","examples":[{"jp":"がっこう","romaji":"gakkou","en":"school"},{"jp":"きって","romaji":"kitte","en":"postage stamp"},{"jp":"ざっし","romaji":"zasshi","en":"magazine"},{"jp":"けっこん","romaji":"kekkon","en":"marriage"},{"jp":"サッカー","romaji":"sakkaa","en":"soccer"},{"jp":"ベッド","romaji":"beddo","en":"bed"}]},"chouon":{"explanation":"A long vowel is held for two beats instead of one. In hiragana this is usually written by adding another vowel character (あ after an あ-row sound, い after an い or え-row sound, う after a う or お-row sound). In katakana, a long vowel is simply marked with the dash ー.","examples":[{"jp":"おかあさん","romaji":"okaa-san","en":"mother (+ あ after あ-row)"},{"jp":"おにいさん","romaji":"onii-san","en":"older brother (+ い after い-row)"},{"jp":"くうき","romaji":"kuuki","en":"air (+ う after う-row)"},{"jp":"せんせい","romaji":"sensei","en":"teacher (+ い after え-row)"},{"jp":"とうきょう","romaji":"Toukyou","en":"Tokyo (+ う after お-row, twice)"},{"jp":"コーヒー","romaji":"koohii","en":"coffee (katakana ー mark)"},{"jp":"ケーキ","romaji":"keeki","en":"cake (katakana ー mark)"}]},"youonHiragana":[{"jp":"きゃ","romaji":"kya"},{"jp":"きゅ","romaji":"kyu"},{"jp":"きょ","romaji":"kyo"},{"jp":"しゃ","romaji":"sha"},{"jp":"しゅ","romaji":"shu"},{"jp":"しょ","romaji":"sho"},{"jp":"ちゃ","romaji":"cha"},{"jp":"ちゅ","romaji":"chu"},{"jp":"ちょ","romaji":"cho"},{"jp":"にゃ","romaji":"nya"},{"jp":"にゅ","romaji":"nyu"},{"jp":"にょ","romaji":"nyo"},{"jp":"ひゃ","romaji":"hya"},{"jp":"ひゅ","romaji":"hyu"},{"jp":"ひょ","romaji":"hyo"},{"jp":"みゃ","romaji":"mya"},{"jp":"みゅ","romaji":"myu"},{"jp":"みょ","romaji":"myo"},{"jp":"りゃ","romaji":"rya"},{"jp":"りゅ","romaji":"ryu"},{"jp":"りょ","romaji":"ryo"},{"jp":"ぎゃ","romaji":"gya"},{"jp":"ぎゅ","romaji":"gyu"},{"jp":"ぎょ","romaji":"gyo"},{"jp":"じゃ","romaji":"ja"},{"jp":"じゅ","romaji":"ju"},{"jp":"じょ","romaji":"jo"},{"jp":"びゃ","romaji":"bya"},{"jp":"びゅ","romaji":"byu"},{"jp":"びょ","romaji":"byo"},{"jp":"ぴゃ","romaji":"pya"},{"jp":"ぴゅ","romaji":"pyu"},{"jp":"ぴょ","romaji":"pyo"}],"youonKatakana":[{"jp":"キャ","romaji":"kya"},{"jp":"キュ","romaji":"kyu"},{"jp":"キョ","romaji":"kyo"},{"jp":"シャ","romaji":"sha"},{"jp":"シュ","romaji":"shu"},{"jp":"ショ","romaji":"sho"},{"jp":"チャ","romaji":"cha"},{"jp":"チュ","romaji":"chu"},{"jp":"チョ","romaji":"cho"},{"jp":"ニャ","romaji":"nya"},{"jp":"ニュ","romaji":"nyu"},{"jp":"ニョ","romaji":"nyo"},{"jp":"ヒャ","romaji":"hya"},{"jp":"ヒュ","romaji":"hyu"},{"jp":"ヒョ","romaji":"hyo"},{"jp":"ミャ","romaji":"mya"},{"jp":"ミュ","romaji":"myu"},{"jp":"ミョ","romaji":"myo"},{"jp":"リャ","romaji":"rya"},{"jp":"リュ","romaji":"ryu"},{"jp":"リョ","romaji":"ryo"},{"jp":"ギャ","romaji":"gya"},{"jp":"ギュ","romaji":"gyu"},{"jp":"ギョ","romaji":"gyo"},{"jp":"ジャ","romaji":"ja"},{"jp":"ジュ","romaji":"ju"},{"jp":"ジョ","romaji":"jo"},{"jp":"ビャ","romaji":"bya"},{"jp":"ビュ","romaji":"byu"},{"jp":"ビョ","romaji":"byo"},{"jp":"ピャ","romaji":"pya"},{"jp":"ピュ","romaji":"pyu"},{"jp":"ピョ","romaji":"pyo"}],"months":[{"jp":"1月","romaji":"ichi-gatsu","en":"January"},{"jp":"2月","romaji":"ni-gatsu","en":"February"},{"jp":"3月","romaji":"san-gatsu","en":"March"},{"jp":"4月","romaji":"shi-gatsu","en":"April (irregular — not yon-gatsu)"},{"jp":"5月","romaji":"go-gatsu","en":"May"},{"jp":"6月","romaji":"roku-gatsu","en":"June"},{"jp":"7月","romaji":"shichi-gatsu","en":"July (irregular — not nana-gatsu)"},{"jp":"8月","romaji":"hachi-gatsu","en":"August"},{"jp":"9月","romaji":"ku-gatsu","en":"September (irregular — not kyuu-gatsu)"},{"jp":"10月","romaji":"juu-gatsu","en":"October"},{"jp":"11月","romaji":"juuichi-gatsu","en":"November"},{"jp":"12月","romaji":"juuni-gatsu","en":"December"},{"jp":"何月","romaji":"nan-gatsu","en":"what month"}],"age":[{"jp":"1歳","romaji":"is-sai","en":"1 year old (irregular)"},{"jp":"2歳","romaji":"ni-sai","en":"2 years old"},{"jp":"3歳","romaji":"san-sai","en":"3 years old"},{"jp":"4歳","romaji":"yon-sai","en":"4 years old"},{"jp":"5歳","romaji":"go-sai","en":"5 years old"},{"jp":"6歳","romaji":"roku-sai","en":"6 years old"},{"jp":"7歳","romaji":"nana-sai","en":"7 years old"},{"jp":"8歳","romaji":"has-sai","en":"8 years old (irregular)"},{"jp":"9歳","romaji":"kyuu-sai","en":"9 years old"},{"jp":"10歳","romaji":"jus-sai","en":"10 years old (irregular)"},{"jp":"20歳","romaji":"hatachi","en":"20 years old (special word)"},{"jp":"何歳 / おいくつ","romaji":"nan-sai / o-ikutsu","en":"how old (casual / polite)"}],"timeHours":[{"jp":"1時","romaji":"ichi-ji","en":"1 o'clock"},{"jp":"2時","romaji":"ni-ji","en":"2 o'clock"},{"jp":"3時","romaji":"san-ji","en":"3 o'clock"},{"jp":"4時","romaji":"yo-ji","en":"4 o'clock (irregular)"},{"jp":"5時","romaji":"go-ji","en":"5 o'clock"},{"jp":"6時","romaji":"roku-ji","en":"6 o'clock"},{"jp":"7時","romaji":"shichi-ji","en":"7 o'clock (irregular)"},{"jp":"8時","romaji":"hachi-ji","en":"8 o'clock"},{"jp":"9時","romaji":"ku-ji","en":"9 o'clock (irregular)"},{"jp":"10時","romaji":"juu-ji","en":"10 o'clock"},{"jp":"11時","romaji":"juuichi-ji","en":"11 o'clock"},{"jp":"12時","romaji":"juuni-ji","en":"12 o'clock"},{"jp":"何時","romaji":"nan-ji","en":"what time"}],"timeMinutes":[{"jp":"1分","romaji":"ip-pun","en":"1 minute (irregular)"},{"jp":"2分","romaji":"ni-fun","en":"2 minutes"},{"jp":"3分","romaji":"san-pun","en":"3 minutes (irregular)"},{"jp":"4分","romaji":"yon-pun","en":"4 minutes"},{"jp":"5分","romaji":"go-fun","en":"5 minutes"},{"jp":"6分","romaji":"rop-pun","en":"6 minutes (irregular)"},{"jp":"7分","romaji":"nana-fun","en":"7 minutes"},{"jp":"8分","romaji":"hap-pun","en":"8 minutes (irregular)"},{"jp":"9分","romaji":"kyuu-fun","en":"9 minutes"},{"jp":"10分","romaji":"jup-pun","en":"10 minutes (irregular)"},{"jp":"30分 / 半","romaji":"san-juppun / han","en":"30 minutes / half past"},{"jp":"何分","romaji":"nan-pun","en":"what minute"}],"timeExamples":[{"jp":"7時です。","romaji":"Shichi-ji desu.","en":"It's 7:00."},{"jp":"9時5分です。","romaji":"Ku-ji go-fun desu.","en":"It's 9:05."},{"jp":"7時半です。","romaji":"Shichi-ji han desu.","en":"It's 7:30."},{"jp":"12時45分です。","romaji":"Juuni-ji yonjuugo-fun desu.","en":"It's 12:45."},{"jp":"今、何時ですか。","romaji":"Ima, nan-ji desu ka.","en":"What time is it now?"}],"dates":[{"jp":"1日","romaji":"tsuitachi","en":"the 1st (special word)"},{"jp":"2日","romaji":"futsuka","en":"the 2nd (special word)"},{"jp":"3日","romaji":"mikka","en":"the 3rd (special word)"},{"jp":"4日","romaji":"yokka","en":"the 4th (special word)"},{"jp":"5日","romaji":"itsuka","en":"the 5th (special word)"},{"jp":"6日","romaji":"muika","en":"the 6th (special word)"},{"jp":"7日","romaji":"nanoka","en":"the 7th (special word)"},{"jp":"8日","romaji":"youka","en":"the 8th (special word)"},{"jp":"9日","romaji":"kokonoka","en":"the 9th (special word)"},{"jp":"10日","romaji":"tooka","en":"the 10th (special word)"},{"jp":"14日","romaji":"juuyokka","en":"the 14th (irregular)"},{"jp":"20日","romaji":"hatsuka","en":"the 20th (special word)"},{"jp":"24日","romaji":"nijuuyokka","en":"the 24th (irregular)"},{"jp":"何日","romaji":"nan-nichi","en":"what day (of the month)"}],"datesNote":"Days 1–10, 14, 20 and 24 use their own special readings and must be memorized. Every other day of the month is simply the number plus 日 (nichi) — 11日 juuichi-nichi, 15日 juugo-nichi, 21日 nijuuichi-nichi, and so on.","bigNumbers":[{"jp":"100","romaji":"hyaku","en":"100"},{"jp":"200","romaji":"ni-hyaku","en":"200"},{"jp":"300","romaji":"san-byaku","en":"300 (irregular)"},{"jp":"400","romaji":"yon-hyaku","en":"400"},{"jp":"500","romaji":"go-hyaku","en":"500"},{"jp":"600","romaji":"rop-pyaku","en":"600 (irregular)"},{"jp":"700","romaji":"nana-hyaku","en":"700"},{"jp":"800","romaji":"hap-pyaku","en":"800 (irregular)"},{"jp":"900","romaji":"kyuu-hyaku","en":"900"},{"jp":"1,000","romaji":"sen","en":"1,000"},{"jp":"2,000","romaji":"ni-sen","en":"2,000"},{"jp":"3,000","romaji":"san-zen","en":"3,000 (irregular)"},{"jp":"8,000","romaji":"has-sen","en":"8,000 (irregular)"},{"jp":"10,000","romaji":"ichi-man","en":"10,000"}],"grammar2":[{"id":"kore-sore-are","title":"これ／それ／あれ","subtitle":"kore / sore / are — \"this / that / that over there\" (as a pronoun)","explanation":"These three stand alone as pronouns for things — they are never directly followed by a noun. これ is near the speaker, それ is near the listener, あれ is far from both. どれ asks \"which one\" among three or more.","examples":[{"jp":"これは 本です。","romaji":"Kore wa hon desu.","en":"This is a book."},{"jp":"それは わたしの かばんです。","romaji":"Sore wa watashi no kaban desu.","en":"That (by you) is my bag."},{"jp":"あれは 山田さんの 車です。","romaji":"Are wa Yamada-san no kuruma desu.","en":"That (over there) is Mr. Yamada's car."},{"jp":"どれが あなたの 傘ですか。","romaji":"Dore ga anata no kasa desu ka.","en":"Which one is your umbrella?"}]},{"id":"kono-sono-ano","title":"この／その／あの + N","subtitle":"kono / sono / ano — \"this / that / that\" (always with a noun)","explanation":"Unlike これ/それ/あれ, these four must be followed directly by a noun — they describe which thing you mean rather than standing in for it. The same near-speaker / near-listener / far-from-both distinction applies, and どの asks \"which ~\".","examples":[{"jp":"この 本は わたしのです。","romaji":"Kono hon wa watashi no desu.","en":"This book is mine."},{"jp":"その 人は 田中さんです。","romaji":"Sono hito wa Tanaka-san desu.","en":"That person (by you) is Mr. Tanaka."},{"jp":"あの 建物は 病院です。","romaji":"Ano tatemono wa byouin desu.","en":"That building (over there) is a hospital."},{"jp":"どの かばんが あなたのですか。","romaji":"Dono kaban ga anata no desu ka.","en":"Which bag is yours?"}]},{"id":"sou-desu","title":"そうです／そうじゃありません","subtitle":"sou desu / sou ja arimasen — confirming or denying \"that's right\"","explanation":"Used to answer a yes/no question that asks what something is (an N1 wa N2 desu ka question): そうです confirms it, そうじゃありません denies it. It only works for identity questions like this — not for every yes/no question.","examples":[{"jp":"これは 辞書ですか。","romaji":"Kore wa jisho desu ka.","en":"Is this a dictionary?"},{"jp":"はい、そうです。","romaji":"Hai, sou desu.","en":"Yes, it is."},{"jp":"いいえ、そうじゃありません。","romaji":"Iie, sou ja arimasen.","en":"No, it isn't."}]},{"id":"ka-ka-alternative","title":"N1は A ですか、B ですか","subtitle":"S1 ka, S2 ka — an either/or question","explanation":"Two か-questions placed back to back offer a choice between A and B, rather than asking yes or no. The answer names whichever one is correct.","examples":[{"jp":"これは ボールペンですか、万年筆ですか。","romaji":"Kore wa boorupen desu ka, mannenhitsu desu ka.","en":"Is this a ballpoint pen or a fountain pen?"},{"jp":"万年筆です。","romaji":"Mannenhitsu desu.","en":"It's a fountain pen."},{"jp":"それは 7ですか、9ですか。","romaji":"Sore wa nana desu ka, kyuu desu ka.","en":"Is that a 7 or a 9?"}]},{"id":"no-omission","title":"N1の (N2省略)","subtitle":"N1 no desu — の standing in for an omitted noun","explanation":"Lesson 1 used の to connect two nouns (わたしの本, \"my book\"). Once the noun is already clear from context, の can stand on its own in its place — わたしの本 shortens to わたしの, \"mine\".","examples":[{"jp":"これは わたしの 本です。 → これは わたしのです。","romaji":"Kore wa watashi no hon desu. → Kore wa watashi no desu.","en":"This is my book. → This is mine."},{"jp":"この 傘は 田中さんのですか。","romaji":"Kono kasa wa Tanaka-san no desu ka.","en":"Is this umbrella Tanaka's?"}]},{"id":"sou-desu-ka","title":"そうですか。","subtitle":"sou desu ka — \"I see\" / \"is that so\"","explanation":"Said with falling intonation, this is a reaction to new information rather than a real question — close to \"oh, I see\" or \"is that right\" in English. With rising intonation it can genuinely ask for confirmation, but the reactive use is far more common.","examples":[{"jp":"A: 今日は 休みです。","romaji":"A: Kyou wa yasumi desu.","en":"A: Today is a day off."},{"jp":"B: そうですか。","romaji":"B: Sou desu ka.","en":"B: Oh, I see."}]}]}</script>
<script>
(function(){
"use strict";

const KANA = JSON.parse(document.getElementById('kana-data').textContent);
const CONTENT = JSON.parse(document.getElementById('content-data').textContent);
const TOTAL_KANA = Object.keys(KANA).length;

/* ---------------- storage helpers ---------------- */
const STORE_KEY = 'n5dojo.mastered.v1';
function loadMastered(){
  try{ return new Set(JSON.parse(localStorage.getItem(STORE_KEY) || '[]')); }
  catch(e){ return new Set(); }
}
function saveMastered(set){
  try{ localStorage.setItem(STORE_KEY, JSON.stringify([...set])); }catch(e){ /* ignore */ }
}
let mastered = loadMastered();

function updateProgressRing(){
  const n = mastered.size;
  document.getElementById('progressCount').textContent = n + '/' + TOTAL_KANA;
  const r = 22, c = 2*Math.PI*r;
  const fill = document.getElementById('ringFill');
  fill.style.strokeDasharray = c;
  fill.style.strokeDashoffset = c * (1 - Math.min(1, n/TOTAL_KANA));
}

/* ---------------- toast ---------------- */
let toastTimer=null;
function toast(msg){
  const el = document.getElementById('toast');
  el.textContent = msg;
  el.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(()=>el.classList.remove('show'), 2200);
}

/* ---------------- speech ---------------- */
let jaVoice = null;
function pickVoice(){
  if(!('speechSynthesis' in window)) return;
  const voices = window.speechSynthesis.getVoices();
  jaVoice = voices.find(v=>v.lang && v.lang.toLowerCase().startsWith('ja')) || null;
}
if('speechSynthesis' in window){
  pickVoice();
  window.speechSynthesis.addEventListener && window.speechSynthesis.addEventListener('voiceschanged', pickVoice);
}
function speak(text, rate){
  if(!('speechSynthesis' in window)){
    toast('Speech playback is not supported on this browser.');
    return;
  }
  try{
    window.speechSynthesis.cancel();
    const u = new SpeechSynthesisUtterance(text);
    u.lang = 'ja-JP';
    u.rate = rate || 0.82;
    if(jaVoice) u.voice = jaVoice;
    window.speechSynthesis.speak(u);
  }catch(e){ toast('Could not play audio.'); }
}

