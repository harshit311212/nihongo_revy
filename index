  tab.addEventListener('click', ()=>{
    activateTab(tab);
    tab.scrollIntoView({inline:'center', block:'nearest', behavior:'smooth'});
  });
});

/* ---------------- lesson filter ---------------- */
document.querySelectorAll('.lesson-btn').forEach(btn=>{
  btn.addEventListener('click', ()=>{
    document.querySelectorAll('.lesson-btn').forEach(b=>b.classList.remove('active'));
    btn.classList.add('active');
    const filter = btn.dataset.lessonFilter;
    let activeHidden = false;
    tabs.forEach(tab=>{
      const show = filter === 'all' || tab.dataset.lesson === 'both' || tab.dataset.lesson === filter;
      tab.hidden = !show;
      if(!show && tab.classList.contains('active')) activeHidden = true;
    });
    if(activeHidden){
      const firstVisible = [...tabs].find(t=>!t.hidden);
      if(firstVisible) activateTab(firstVisible);
    }
  });
});

