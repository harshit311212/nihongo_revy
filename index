<style>
/* ---------------------------------------------------------------
   Design plan
   Palette: washi paper + sumi ink + hanko-seal vermilion + moss accent
   Type: Yuji Syuku (brush display) / Zen Maru Gothic (bilingual body+UI)
   Layout: workbook — horizontal tab "index" above a single practice pane,
   each pane a genkouyoushi-style sheet of cards
----------------------------------------------------------------*/
:root{
  --bg:#faf6ec;
  --bg-alt:#f1e9d8;
  --panel:#fffdf8;
  --ink:#232a40;
  --ink-soft:#656d84;
  --accent:#b5422e;
  --accent-ink:#ffffff;
  --accent-2:#5c7a5e;
  --line:rgba(35,42,64,.14);
  --guide:rgba(35,42,64,.28);
  --shadow:0 1px 2px rgba(35,42,64,.06), 0 8px 24px -16px rgba(35,42,64,.25);
  --radius:14px;
  --font-display:"Yuji Syuku", "Hiragino Mincho ProN", serif;
  --font-body:"Zen Maru Gothic", "Hiragino Maru Gothic ProN", "Noto Sans JP", sans-serif;
  color-scheme: light;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#15161f;
    --bg-alt:#1d1f2c;
    --panel:#1b1c27;
    --ink:#ece6d8;
    --ink-soft:#a7acc0;
    --accent:#e2704f;
    --accent-ink:#1a0e09;
    --accent-2:#86b389;
    --line:rgba(236,230,216,.14);
    --guide:rgba(236,230,216,.3);
    --shadow:0 1px 2px rgba(0,0,0,.3), 0 8px 24px -16px rgba(0,0,0,.6);
    color-scheme: dark;
  }
}
:root[data-theme="dark"]{
  --bg:#15161f;
  --bg-alt:#1d1f2c;
  --panel:#1b1c27;
  --ink:#ece6d8;
  --ink-soft:#a7acc0;
  --accent:#e2704f;
  --accent-ink:#1a0e09;
  --accent-2:#86b389;
  --line:rgba(236,230,216,.14);
  --guide:rgba(236,230,216,.3);
  --shadow:0 1px 2px rgba(0,0,0,.3), 0 8px 24px -16px rgba(0,0,0,.6);
  color-scheme: dark;
}

*{box-sizing:border-box;}
body{
  background:var(--bg);
  color:var(--ink);
  font-family:var(--font-body);
  padding-left:max(16px, env(safe-area-inset-left,0px));
  padding-right:max(16px, env(safe-area-inset-right,0px));
}
h1,h2,h3{font-family:var(--font-display); font-weight:400; text-wrap:balance; margin:0;}
p{margin:0;}
button{font-family:inherit; color:inherit;}
::selection{background:var(--accent); color:var(--accent-ink);}

.wrap{max-width:860px; margin:0 auto; padding-block:18px 48px;}

/* ---------- header ---------- */
.topbar{
  display:flex; align-items:center; justify-content:space-between; gap:14px;
  padding-block:6px 16px;
}
.brand{display:flex; align-items:center; gap:12px; min-width:0;}
.brand-mark{
  font-family:var(--font-display); font-size:2.1rem; line-height:1;
  width:48px; height:48px; flex:none; border-radius:50%;
  display:flex; align-items:center; justify-content:center;
  background:var(--accent); color:var(--accent-ink);
}
.brand-text h1{font-size:1.5rem;}
.brand-text p{font-size:.78rem; color:var(--ink-soft); margin-top:2px;}
.stamp-ring{
  position:relative; width:52px; height:52px; flex:none; display:grid; place-items:center;
}
.stamp-ring svg{position:absolute; inset:0; transform:rotate(-90deg);}
.stamp-ring circle{fill:none; stroke-width:4;}
.stamp-ring .track{stroke:var(--line);}
.stamp-ring .fill{stroke:var(--accent); stroke-linecap:round; transition:stroke-dashoffset .4s ease;}
.stamp-ring span{font-size:.62rem; font-weight:700; color:var(--ink-soft); text-align:center; line-height:1.1;}

/* ---------- lesson filter ---------- */
.lesson-filter{
  display:flex; gap:6px; margin-bottom:12px; background:var(--bg-alt); border-radius:999px; padding:4px; width:fit-content;
  max-width:100%; overflow-x:auto;
}
.lesson-btn{
  flex:none; border:none; background:transparent; color:var(--ink-soft); cursor:pointer;
  padding:7px 15px; border-radius:999px; font-size:.78rem; font-weight:700; letter-spacing:.01em;
}
.lesson-btn.active{background:var(--accent); color:var(--accent-ink);}
.lesson-btn:focus-visible{outline:2px solid var(--accent); outline-offset:2px;}

/* ---------- tab bar ---------- */
.tabbar{
  display:flex; gap:6px; overflow-x:auto; padding-bottom:10px; margin-bottom:18px;
  border-bottom:1px solid var(--line); scrollbar-width:thin;
}
.tabbar::-webkit-scrollbar{height:6px;}
.tab{
  flex:none; border:none; background:transparent; cursor:pointer;
  padding:8px 14px 10px; border-radius:10px 10px 0 0; text-align:center;
  display:flex; flex-direction:column; gap:2px; position:relative; color:var(--ink-soft);
}
.tab span.jp{font-size:.95rem; font-weight:700; font-family:var(--font-body); color:inherit;}
.tab small{font-size:.6rem; letter-spacing:.04em; text-transform:uppercase;}
.tab.active{color:var(--accent);}
.tab.active::after{
  content:""; position:absolute; left:10%; right:10%; bottom:-1px; height:2px; background:var(--accent);
}
.tab:focus-visible{outline:2px solid var(--accent); outline-offset:2px;}

/* ---------- panels ---------- */
.panel{display:none;}
.panel.active{display:block; animation:fade .25s ease;}
@keyframes fade{from{opacity:0; transform:translateY(4px);} to{opacity:1; transform:none;}}

.panel-head{margin-bottom:16px;}
.panel-head h2{font-size:1.6rem; margin-bottom:4px;}
.panel-head p.lead{color:var(--ink-soft); font-size:.9rem; max-width:62ch;}

.group-block{margin-bottom:26px;}
.group-title{display:flex; align-items:baseline; gap:8px; margin-bottom:10px;}
.group-title .jp{font-size:1.05rem; font-weight:700;}
.group-title .en{font-size:.72rem; color:var(--ink-soft); text-transform:uppercase; letter-spacing:.05em;}

/* ---------- kana grid ---------- */
.kana-grid{
  display:grid; grid-template-columns:repeat(auto-fill, minmax(64px,1fr)); gap:8px;
}
.kana-card{
  background:var(--panel); border:1px solid var(--line); border-radius:12px;
  padding:10px 4px 8px; cursor:pointer; display:flex; flex-direction:column; align-items:center; gap:2px;
  box-shadow:var(--shadow); position:relative; transition:transform .15s ease;
}
.kana-card:hover{transform:translateY(-2px);}
.kana-card:focus-visible{outline:2px solid var(--accent); outline-offset:2px;}
.kc-char{font-family:var(--font-display); font-size:1.7rem; line-height:1;}
.kc-romaji{font-size:.62rem; color:var(--ink-soft); letter-spacing:.02em;}
.kana-card.mastered::before{
  content:"印"; position:absolute; top:-6px; right:-6px; width:20px; height:20px; border-radius:50%;
  background:var(--accent); color:var(--accent-ink); font-size:.55rem; display:flex; align-items:center; justify-content:center;
  font-family:var(--font-body); box-shadow:var(--shadow);
}

/* ---------- combined / vocab flashcards ---------- */
.flash-grid{display:grid; grid-template-columns:repeat(auto-fill, minmax(130px,1fr)); gap:10px;}
.flash{
  background:var(--panel); border:1px solid var(--line); border-radius:var(--radius);
  box-shadow:var(--shadow); padding:14px 12px; cursor:pointer; min-height:92px;
  display:flex; flex-direction:column; justify-content:center; gap:4px; position:relative;
}
.flash .jp{font-family:var(--font-display); font-size:1.35rem;}
.flash .romaji{font-size:.72rem; color:var(--ink-soft);}
.flash .en{font-size:.74rem; color:var(--ink-soft); display:none;}
.flash.flipped .en{display:block;}
.flash.flipped .romaji{display:block;}
.flash .audio-mini{
  position:absolute; top:8px; right:8px; width:26px; height:26px; border-radius:50%;
  border:1px solid var(--line); background:var(--bg-alt); display:flex; align-items:center; justify-content:center;
  font-size:.8rem; cursor:pointer;
}
.flash .pencil-mini{
  position:absolute; bottom:8px; right:8px; width:26px; height:26px; border-radius:50%;
  border:1px solid var(--line); background:var(--bg-alt); display:flex; align-items:center; justify-content:center;
  font-size:.72rem; cursor:pointer;
}

/* ---------- explanation card ---------- */
.info-card{
  background:var(--bg-alt); border:1px solid var(--line); border-radius:var(--radius);
  padding:16px 18px; margin-bottom:16px; font-size:.88rem; line-height:1.55;
}
.info-card b{color:var(--accent);}

/* ---------- grammar ---------- */
.grammar-card{
  background:var(--panel); border:1px solid var(--line); border-radius:var(--radius);
  box-shadow:var(--shadow); padding:18px 18px 16px; margin-bottom:14px;
}
.grammar-card h3{font-size:1.35rem; margin-bottom:2px;}
.grammar-card .subtitle{font-size:.78rem; color:var(--accent); font-weight:700; margin-bottom:10px; display:block;}
.grammar-card .explain{font-size:.87rem; line-height:1.6; color:var(--ink-soft); margin-bottom:12px;}
.example-row{
  display:flex; align-items:center; gap:10px; padding:9px 0; border-top:1px solid var(--line);
}
.example-row:first-of-type{border-top:none;}
.example-text{flex:1; min-width:0;}
.example-text .jp{font-size:1.02rem;}
.example-text .romaji{font-size:.74rem; color:var(--ink-soft);}
.example-text .en{font-size:.78rem; color:var(--ink-soft); margin-top:1px;}
.audio-btn{
  flex:none; width:34px; height:34px; border-radius:50%; border:1px solid var(--line);
  background:var(--bg-alt); cursor:pointer; font-size:.95rem; display:flex; align-items:center; justify-content:center;
}
.audio-btn:active{transform:scale(.93);}

/* ---------- self intro ---------- */
.intro-grid{display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:10px; margin-bottom:16px;}
.field label{font-size:.72rem; color:var(--ink-soft); text-transform:uppercase; letter-spacing:.04em; display:block; margin-bottom:4px;}
.field select{
  width:100%; padding:9px 10px; border-radius:10px; border:1px solid var(--line); background:var(--panel); color:var(--ink);
  font-family:inherit; font-size:.9rem;
}
.intro-script{
  background:var(--panel); border:1px solid var(--line); border-radius:var(--radius); box-shadow:var(--shadow);
  padding:16px 18px; margin-bottom:14px;
}
.intro-line{padding:7px 0; border-top:1px solid var(--line);}
.intro-line:first-child{border-top:none;}
.intro-line .jp{font-size:1.05rem;}
.intro-line .romaji{font-size:.75rem; color:var(--ink-soft);}
.intro-line .en{font-size:.78rem; color:var(--ink-soft);}
.btn-main{
  background:var(--accent); color:var(--accent-ink); border:none; border-radius:999px;
  padding:11px 22px; font-size:.92rem; font-weight:700; cursor:pointer; display:inline-flex; align-items:center; gap:8px;
  box-shadow:var(--shadow);
}
.btn-main:active{transform:scale(.97);}
.btn-ghost{
  background:transparent; border:1px solid var(--line); border-radius:999px; padding:9px 16px;
  font-size:.85rem; color:var(--ink); cursor:pointer;
}

/* ---------- quiz ---------- */
.quiz-modes{display:flex; gap:8px; margin-bottom:16px; flex-wrap:wrap;}
.mode-btn{
  padding:9px 16px; border-radius:999px; border:1px solid var(--line); background:var(--panel); cursor:pointer; font-size:.85rem;
}
.mode-btn.active{background:var(--accent); color:var(--accent-ink); border-color:var(--accent);}
.quiz-stage{
  background:var(--panel); border:1px solid var(--line); border-radius:var(--radius); box-shadow:var(--shadow);
  padding:28px 20px; text-align:center; margin-bottom:14px;
}
.quiz-prompt{font-family:var(--font-display); font-size:3.4rem; margin-bottom:6px; line-height:1;}
.quiz-sub{font-size:.8rem; color:var(--ink-soft); margin-bottom:18px;}
.quiz-options{display:grid; grid-template-columns:repeat(2,1fr); gap:10px; max-width:420px; margin:0 auto;}
.quiz-opt{
  padding:14px 10px; border-radius:12px; border:1px solid var(--line); background:var(--bg-alt);
  font-size:1.15rem; cursor:pointer; font-family:var(--font-display);
}
.quiz-opt.correct{background:var(--accent-2); color:var(--accent-ink); border-color:var(--accent-2);}
.quiz-opt.wrong{background:var(--accent); color:var(--accent-ink); border-color:var(--accent);}
.quiz-meta{display:flex; justify-content:space-between; font-size:.8rem; color:var(--ink-soft); margin-bottom:10px;}
.quiz-end{text-align:center; padding:20px 0;}
.quiz-end .score{font-family:var(--font-display); font-size:2.6rem;}
.quiz-type-row{border-bottom:1px solid var(--line); padding-bottom:16px;}
.quiz-opt.text-opt{font-family:var(--font-body); font-size:.88rem; text-align:left; line-height:1.35; padding:12px 14px;}
.quiz-options.wide{max-width:540px;}
.quiz-speaker-btn{
  width:84px; height:84px; border-radius:50%; border:none; background:var(--accent); color:var(--accent-ink);
  font-size:2.1rem; cursor:pointer; display:flex; align-items:center; justify-content:center; margin:0 auto 10px;
  box-shadow:var(--shadow);
}
.quiz-speaker-btn:active{transform:scale(.95);}
.quiz-replay{font-size:.76rem; color:var(--ink-soft);}

/* ---------- practice overlay ---------- */
.practice-overlay{
  position:fixed; inset:0; background:rgba(21,22,31,.55); backdrop-filter:blur(2px);
  display:flex; align-items:center; justify-content:center; z-index:50;
  padding:max(16px, env(safe-area-inset-top,0px)) max(16px, env(safe-area-inset-right,0px)) max(16px, env(safe-area-inset-bottom,0px)) max(16px, env(safe-area-inset-left,0px));
  overflow-y:auto;
}
.practice-overlay[hidden]{display:none;}
.practice-card{
  background:var(--panel); border-radius:20px; box-shadow:var(--shadow); width:min(360px,100%);
  padding:18px 18px 20px; position:relative; margin:auto;
}
.practice-close{
  position:absolute; top:10px; right:10px; width:30px; height:30px; border-radius:50%; border:none;
  background:var(--bg-alt); font-size:1.1rem; cursor:pointer; color:var(--ink);
}
.practice-header{display:flex; align-items:center; justify-content:center; gap:10px; margin-bottom:4px;}
.practice-romaji{font-size:1.1rem; font-weight:700; letter-spacing:.02em;}
.practice-group{text-align:center; font-size:.7rem; color:var(--ink-soft); margin-bottom:12px; text-transform:uppercase; letter-spacing:.04em;}
.practice-canvas-wrap{
  position:relative; width:100%; aspect-ratio:1/1; max-width:300px; margin:0 auto 14px;
  border-radius:16px; overflow:hidden; background:var(--bg-alt); border:1px solid var(--line); touch-action:none;
}
.practice-canvas-wrap svg, .practice-canvas-wrap canvas{position:absolute; inset:0; width:100%; height:100%;}
.grid-line{stroke:var(--line); stroke-width:.6; stroke-dasharray:3 3;}
.grid-border{stroke:var(--line); stroke-width:1; fill:none;}
.guide-stroke{fill:none; stroke:var(--guide); stroke-width:4; stroke-linecap:round; stroke-linejoin:round;}
.anim-stroke{fill:none; stroke:var(--accent); stroke-width:4.2; stroke-linecap:round; stroke-linejoin:round;}
.anim-dot{fill:var(--accent);}
.num-badge-bg{fill:var(--accent); opacity:.92;}
.num-badge-text{fill:var(--accent-ink); font-size:7px; font-family:var(--font-body); text-anchor:middle; dominant-baseline:central;}
#animSvg{pointer-events:none;}
#animSvg[hidden]{display:none;}
.practice-controls{display:flex; flex-wrap:wrap; gap:8px; justify-content:center; margin-bottom:10px;}
.icon-btn{
  border:1px solid var(--line); background:var(--bg-alt); border-radius:999px; padding:8px 13px; font-size:.78rem; cursor:pointer;
}
.icon-btn.primary{background:var(--accent); color:var(--accent-ink); border-color:var(--accent);}
.mastered-toggle{
  display:flex; align-items:center; gap:6px; font-size:.78rem; justify-content:center; color:var(--ink-soft); margin-top:4px;
}

/* ---------- toast ---------- */
.toast{
  position:fixed; left:50%; bottom:max(20px, env(safe-area-inset-bottom,0px)); transform:translate(-50%,8px);
  background:var(--ink); color:var(--bg); padding:10px 16px; border-radius:999px; font-size:.82rem;
  opacity:0; pointer-events:none; transition:opacity .25s ease, transform .25s ease; z-index:80; max-width:88vw; text-align:center;
}
.toast.show{opacity:1; transform:translate(-50%,0);}

footer.credits{margin-top:30px; font-size:.72rem; color:var(--ink-soft); text-align:center; line-height:1.6;}
footer.credits a{color:inherit;}

@media (max-width:420px){
  .quiz-prompt{font-size:2.6rem;}
  .brand-text h1{font-size:1.25rem;}
}
</style>

<div class="wrap">
  <header class="topbar">
    <div class="brand">
      <div class="brand-mark">文</div>
