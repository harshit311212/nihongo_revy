      </div>
      <div class="flash-grid" id="weekdaysGrid"></div>
    </section>

    <section class="panel" id="panel-greetings">
      <div class="panel-head">
        <h2>あいさつ — Greetings</h2>
        <p class="lead">The everyday phrases students reach for first.</p>
      </div>
