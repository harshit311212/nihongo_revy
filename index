    <button class="tab" data-tab="weekdays" data-lesson="1"><span class="jp">曜日</span><small>Weekdays</small></button>
    <button class="tab" data-tab="greetings" data-lesson="1"><span class="jp">あいさつ</span><small>Greetings</small></button>
