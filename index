function svgNS(tag){ return document.createElementNS('http://www.w3.org/2000/svg', tag); }

function buildGuide(char){
  guideSvg.innerHTML = '';
  // grid: border + center cross (genkouyoushi style)
  const border = svgNS('rect');
  border.setAttribute('x','1'); border.setAttribute('y','1');
  border.setAttribute('width','107'); border.setAttribute('height','107');
  border.setAttribute('class','grid-border');
  guideSvg.appendChild(border);
  const vline = svgNS('line');
  vline.setAttribute('x1','54.5'); vline.setAttribute('y1','1'); vline.setAttribute('x2','54.5'); vline.setAttribute('y2','108');
  vline.setAttribute('class','grid-line');
  guideSvg.appendChild(vline);
  const hline = svgNS('line');
  hline.setAttribute('x1','1'); hline.setAttribute('y1','54.5'); hline.setAttribute('x2','108'); hline.setAttribute('y2','54.5');
  hline.setAttribute('class','grid-line');
  guideSvg.appendChild(hline);

  const data = KANA[char];
  const guideGroup = svgNS('g');
  data.paths.forEach(d=>{
    const p = svgNS('path');
    p.setAttribute('d', d);
    p.setAttribute('class','guide-stroke');
    guideGroup.appendChild(p);
  });
  guideSvg.appendChild(guideGroup);

  const numGroup = svgNS('g');
  numGroup.id = 'numGroup';
  numGroup.style.display = showNumbers ? '' : 'none';
  data.numbers.forEach(n=>{
    const c = svgNS('circle');
    c.setAttribute('cx', n.x); c.setAttribute('cy', n.y-2.5); c.setAttribute('r','4');
    c.setAttribute('class','num-badge-bg');
    numGroup.appendChild(c);
    const t = svgNS('text');
    t.setAttribute('x', n.x); t.setAttribute('y', n.y-2.3);
    t.setAttribute('class','num-badge-text');
    t.textContent = n.n;
    numGroup.appendChild(t);
  });
  guideSvg.appendChild(numGroup);
}

function setupCanvas(){
  const rect = canvas.getBoundingClientRect();
  const dpr = window.devicePixelRatio || 1;
  canvas.width = Math.round(rect.width*dpr);
  canvas.height = Math.round(rect.height*dpr);
  ctx.setTransform(dpr,0,0,dpr,0,0);
  ctx.lineCap = 'round'; ctx.lineJoin = 'round'; ctx.lineWidth = 6;
  ctx.strokeStyle = getComputedStyle(document.documentElement).getPropertyValue('--ink').trim() || '#232a40';
  redrawCanvas();
}
function redrawCanvas(){
  const rect = canvas.getBoundingClientRect();
  ctx.clearRect(0,0,rect.width,rect.height);
  strokesDrawn.forEach(stroke=>{
    if(stroke.length<2) return;
    ctx.beginPath();
    ctx.moveTo(stroke[0].x, stroke[0].y);
    for(let i=1;i<stroke.length;i++) ctx.lineTo(stroke[i].x, stroke[i].y);
    ctx.stroke();
  });
}
function eventPos(e){
  const rect = canvas.getBoundingClientRect();
  return {x: e.clientX-rect.left, y: e.clientY-rect.top};
}
let drawing = false;
canvas.addEventListener('pointerdown', e=>{
  drawing = true;
  canvas.setPointerCapture(e.pointerId);
  const p = eventPos(e);
  strokesDrawn.push([p]);
  ctx.beginPath(); ctx.moveTo(p.x,p.y);
});
canvas.addEventListener('pointermove', e=>{
  if(!drawing) return;
  const p = eventPos(e);
  const stroke = strokesDrawn[strokesDrawn.length-1];
  stroke.push(p);
  ctx.lineTo(p.x,p.y); ctx.stroke();
});
function endStroke(){ drawing = false; }
canvas.addEventListener('pointerup', endStroke);
canvas.addEventListener('pointercancel', endStroke);
canvas.addEventListener('pointerleave', endStroke);

document.getElementById('btnUndo').addEventListener('click', ()=>{
  strokesDrawn.pop();
  redrawCanvas();
});
document.getElementById('btnClear').addEventListener('click', ()=>{
  strokesDrawn = [];
  redrawCanvas();
});
document.getElementById('btnToggleNumbers').addEventListener('click', (e)=>{
  showNumbers = !showNumbers;
  const g = document.getElementById('numGroup');
  if(g) g.style.display = showNumbers ? '' : 'none';
  e.currentTarget.classList.toggle('primary', showNumbers);
});

function animateStroke(path, dot){
  return new Promise(resolve=>{
    const len = path.getTotalLength();
    path.style.strokeDasharray = len;
    path.style.strokeDashoffset = len;
    void path.getBoundingClientRect();
    const duration = Math.min(1400, Math.max(380, len*11));
    const start = performance.now();
    function step(now){
      const t = Math.min(1, (now-start)/duration);
      path.style.strokeDashoffset = String(len*(1-t));
      const pt = path.getPointAtLength(len*t);
      dot.setAttribute('cx', pt.x); dot.setAttribute('cy', pt.y);
      if(t<1) requestAnimationFrame(step); else resolve();
    }
    requestAnimationFrame(step);
  });
}
let animToken = 0;
async function playStrokeOrder(char){
  const myToken = ++animToken;
  const data = KANA[char];
  animSvg.innerHTML = '';
  animSvg.hidden = false;
  const dot = svgNS('circle');
  dot.setAttribute('r','2.6'); dot.setAttribute('class','anim-dot');
  for(const d of data.paths){
    if(myToken !== animToken) return;
    const p = svgNS('path');
    p.setAttribute('d', d);
    p.setAttribute('class','anim-stroke');
    animSvg.appendChild(p);
    animSvg.appendChild(dot);
    await animateStroke(p, dot);
    if(myToken !== animToken) return;
    await new Promise(r=>setTimeout(r,140));
  }
  await new Promise(r=>setTimeout(r,350));
  if(myToken === animToken){ animSvg.hidden = true; animSvg.innerHTML=''; }
}
document.getElementById('btnPlayStroke').addEventListener('click', ()=>{
  if(currentChar) playStrokeOrder(currentChar);
});

function openPractice(char, onClose){
  if(!KANA[char]){ return; }
  currentChar = char;
  afterCloseCallback = onClose || null;
  strokesDrawn = [];
  showNumbers = false;
  document.getElementById('btnToggleNumbers').classList.remove('primary');
  document.getElementById('practiceRomaji').textContent = char + '　' + KANA[char].romaji;
  const groupLabels = {
    hiragana_base:'Hiragana', hiragana_dakuten:'Hiragana · voiced', hiragana_handakuten:'Hiragana · semi-voiced', hiragana_small:'Hiragana · small',
    katakana_base:'Katakana', katakana_dakuten:'Katakana · voiced', katakana_handakuten:'Katakana · semi-voiced', katakana_small:'Katakana · small',
    long_vowel:'Prolongation mark'
  };
  document.getElementById('practiceGroup').textContent = groupLabels[KANA[char].group] || '';
  document.getElementById('masteredCheck').checked = mastered.has(char);
  buildGuide(char);
  overlay.hidden = false;
  requestAnimationFrame(setupCanvas);
}
function closePractice(){
  overlay.hidden = true;
  animToken++;
  window.speechSynthesis && window.speechSynthesis.cancel();
  const cb = afterCloseCallback;
  afterCloseCallback = null;
  if(cb) setTimeout(cb, 150);
}
